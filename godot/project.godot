; Projeto Merge Defense (O Ultimo Refugio)
; Godot 4.7.2-stable — renderer Compatibility (M09), landscape 1200x540 (M05)
Config_version=5

[application]

config/name="Merge Defense - O Ultimo Refugio"
config/description="Merge defense de gatos contra zumbis."
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.08, 0.07, 0.12, 1)
config/icon="res://assets/art/Ui/Logo.png"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
SaveSystem="*res://scripts/core/save_system.gd"
GameSettings="*res://scripts/core/settings.gd"
Localization="*res://scripts/core/localization.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
FeatureFlags="*res://scripts/core/feature_flags.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"

[display]

window/size/viewport_width=1200
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="sensor_landscape"

[gui]

theme/default_font_antialiasing=1
theme/default_font_generate_mipmaps=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

extends SceneTree
## AutoPlayTest.gd — Teste automatizado de fluxo completo: splash→menu→level_select→gameplay→win/lose
## Uso: godot --headless --path . -s res://scripts/autoplay_test.gd [-- --stage P1]
##
## Correções (M20):
##  - SceneTree NÃO possui get_tree(); usa-se root / current_scene diretamente.
##  - Em --headless, autoloads (GameState, SceneRouter...) não são instanciados;
##    esta suíte instancia manualmente os Autoload singleton e injeta o SceneTree
##    neles (get_tree() == self).
##  - MouseButton.LEFT não existe em GDScript 4; usar a constante global
##    MOUSE_BUTTON_LEFT.
##  - game.get("_coins_lbl") retorna null para variáveis de script privadas;
##    acessar as propriedades diretamente (GameScene é tipado via class_name).
##  - _optimal_merge/_on_victory/_on_defeat não existem; os nomes reais são
##    sim.move_cat / _on_win / _on_lose.

const AUTOLOADS := [
	["EventBus", "res://scripts/core/event_bus.gd"],
	["GameState", "res://scripts/core/game_state.gd"],
	["SceneRouter", "res://scripts/core/scene_router.gd"],
	["SaveSystem", "res://scripts/core/save_system.gd"],
	["GameSettings", "res://scripts/core/settings.gd"],
	["Localization", "res://scripts/core/localization.gd"],
	["AudioManager", "res://scripts/core/audio_manager.gd"],
	["FeatureFlags", "res://scripts/core/feature_flags.gd"],
]

var target_stage := "P1"
var _current_scene: Node = null
var _test_passed := true
var _errors: Array = []
var _current_step := ""

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	for i in args.size():
		if args[i] == "--stage" and i + 1 < args.size():
			target_stage = args[i + 1]

	print("=== AutoPlayTest: Iniciando fluxo completo para " + target_stage + " ===")

	_bootstrap_autoloads()

	# 1. Test Splash → Menu
	await _test_splash_to_menu()
	# 2. Test Menu → LevelSelect
	await _test_menu_to_level_select()
	# 3. Test LevelSelect → Gameplay
	await _test_level_select_to_gameplay()
	# 4. Test Gameplay mechanics
	await _test_gameplay_mechanics()
	# 5. Test Pause/Resume
	await _test_pause_resume()
	# 6. Test Win/Lose flow
	await _test_win_lose_flow()

	# Report
	_report()
	quit(0 if _test_passed else 1)

func _bootstrap_autoloads() -> void:
	## Em -s/script mode os autoloads do projeto não são criados; replicamos a
	## ordem do project.godot e injetamos este SceneTree nos singletons.
	for entry in AUTOLOADS:
		var name: String = entry[0]
		if root.get_node_or_null(NodePath(name)) != null:
			continue
		var s: Node = (load(entry[1]) as GDScript).new()
		s.name = name
		root.add_child(s)  # _ready roda aqui, com get_tree() == self

func _goto(path: String) -> void:
	## Versão síncrona do SceneRouter.goto para o teste (sem fade/busy).
	var packed: PackedScene = load(path)
	if packed == null:
		_add_error("Cena não encontrada: " + path)
		return
	if is_instance_valid(_current_scene):
		_current_scene.queue_free()
	_current_scene = packed.instantiate()
	root.add_child.call_deferred(_current_scene)
	current_scene = _current_scene
	await process_frame
	await process_frame

# ---------------------------- Etapas ----------------------------

func _test_splash_to_menu() -> void:
	_current_step = "Splash → Menu"
	print("Teste: " + _current_step)

	await _goto("res://scenes/splash.tscn")
	if not is_instance_valid(_current_scene):
		return

	# Simula toque/clique no splash (fallback _input do próprio scene)
	var click_event := InputEventMouseButton.new()
	click_event.button_index = MOUSE_BUTTON_LEFT
	click_event.pressed = true
	click_event.position = Vector2(600, 270)
	if _current_scene.has_method("_input"):
		_current_scene._input(click_event)
	else:
		_add_error("Splash não tem método _input")

	await process_frame
	await process_frame

	if current_scene.get_scene_file_path() != "res://scenes/main_menu.tscn":
		_add_error("Navegação splash→menu falhou. Cena atual: " + str(current_scene.get_scene_file_path()))
	else:
		print("  ✓ Splash → Menu OK")

func _test_menu_to_level_select() -> void:
	_current_step = "Menu → LevelSelect"
	print("Teste: " + _current_step)

	var menu := current_scene
	if menu.get_scene_file_path() != "res://scenes/main_menu.tscn":
		_add_error("Não está no menu principal")
		return

	var play_btn: Button = null
	var vboxes := menu.find_children("*", "VBoxContainer", true, false)
	for vb in vboxes:
		for child in vb.get_children():
			if child is Button and play_btn == null:
				play_btn = child
	if play_btn == null:
		_add_error("Botão Jogar não encontrado no menu")
		return

	play_btn.pressed.emit()
	await process_frame
	await process_frame

	if current_scene.get_scene_file_path() != "res://scenes/level_select.tscn":
		_add_error("Navegação menu→level_select falhou. Cena atual: " + str(current_scene.get_scene_file_path()))
	else:
		print("  ✓ Menu → LevelSelect OK")

func _test_level_select_to_gameplay() -> void:
	_current_step = "LevelSelect → Gameplay"
	print("Teste: " + _current_step)

	var level_select := current_scene
	if level_select.get_scene_file_path() != "res://scenes/level_select.tscn":
		_add_error("Não está no level_select")
		return

	var stage_btn := _find_stage_button(level_select, target_stage)
	if stage_btn == null:
		_add_error("Botão da fase " + target_stage + " não encontrado")
		return

	stage_btn.pressed.emit()
	await process_frame
	await process_frame
	await process_frame

	if current_scene.get_scene_file_path() != "res://scenes/game.tscn":
		_add_error("Navegação level_select→game falhou. Cena atual: " + str(current_scene.get_scene_file_path()))
	else:
		print("  ✓ LevelSelect → Gameplay OK")

func _test_gameplay_mechanics() -> void:
	_current_step = "Mecânicas de Gameplay"
	print("Teste: " + _current_step)

	var game := current_scene as GameScene
	if game == null or game.get_scene_file_path() != "res://scenes/game.tscn":
		_add_error("Não está na cena de jogo")
		return

	await process_frame
	await process_frame

	# Teste 1: HUD (variáveis de script — sem getter, acesso direto)
	var hud_tests := [
		[game._coins_lbl, "Coins label"],
		[game._gems_lbl, "Gems label"],
		[game._wave_lbl, "Wave label"],
		[game._buy_btn, "Buy button"],
		[game._start_btn, "Start wave button"],
		[game._speed_btn, "Speed button"],
		[game._base_bar, "Base HP bar"],
	]
	for test in hud_tests:
		if test[0] == null:
			_add_error("HUD element missing: " + String(test[1]))
		else:
			print("  ✓ HUD: " + String(test[1]) + " OK")

	# Teste 2: fluxo de compra de gato
	game._on_buy()
	await process_frame
	var has_cat := false
	for t in game.sim.towers:
		if t != null:
			has_cat = true
			break
	if has_cat:
		print("  ✓ Compra de gato funciona")
	else:
		_add_error("Compra de gato não colocou gato no slot")

	# Teste 3: merge (API real: sim.move_cat entre slots ocupados de mesmo tier)
	game._on_buy()
	var occupied: Array = []
	for s in game.sim.slot_count:
		if game.sim.towers[s] != null:
			occupied.append(s)
	if occupied.size() >= 2:
		var a: int = occupied[0]
		var b: int = occupied[1]
		game.sim.towers[b]["tier"] = game.sim.towers[a]["tier"]  # força mesmo tier
		var result := game.sim.move_cat(a, b)
		if result == "merged":
			print("  ✓ Merge (sim.move_cat) funciona")
		else:
			_add_error("Merge esperado, obtido: " + result)
	else:
		_add_error("Slots insuficientes para testar merge")

	# Teste 4: iniciar onda
	game._on_start_wave()
	await process_frame
	print("  ✓ Botão Iniciar Onda funciona")

	# Teste 5: velocidade 1x/2x
	game._on_speed()
	await process_frame
	if game.speed_mult == 2:
		print("  ✓ Botão 1x/2x funciona")
	else:
		_add_error("Toggle de velocidade não mudou speed_mult (obtido: %d)" % game.speed_mult)

func _test_pause_resume() -> void:
	_current_step = "Pause/Resume"
	print("Teste: " + _current_step)

	var game := current_scene as GameScene
	if game == null or game.get_scene_file_path() != "res://scenes/game.tscn":
		_add_error("Não está no jogo para testar pause")
		return

	# ESC (ui_cancel) abre o menu de pausa
	var esc_event := InputEventKey.new()
	esc_event.keycode = KEY_ESCAPE
	esc_event.pressed = true
	if game.has_method("_input"):
		game._input(esc_event)

	await process_frame

	if game._pause_popup != null and game._pause_popup.visible:
		print("  ✓ Pause menu abriu com ESC")
		game._popup_resume()
		await process_frame
		if not game._pause_popup.visible and not paused:
			print("  ✓ Resume funciona")
		else:
			_add_error("Resume não fechou o pause / árvore continua pausada")
	else:
		_add_error("Pause menu não abriu com ESC")

func _test_win_lose_flow() -> void:
	_current_step = "Win/Lose Flow"
	print("Teste: " + _current_step)

	var game := current_scene as GameScene
	if game == null:
		_add_error("Cena de jogo não disponível para win/lose")
		return

	# Handlers reais de vitória/derrota (nomes corretos: _on_win / _on_lose)
	if game.has_method("_on_win") and game.has_method("_on_lose"):
		print("  ✓ Handlers de vitória/derrota existem (_on_win/_on_lose)")
	else:
		_add_error("Handlers de vitória/derrota não encontrados")

	# Popups de vitória/derrota
	if game.has_method("_build_win_popup") and game.has_method("_build_lose_popup"):
		print("  ✓ Funções de popup win/lose existem")
	else:
		_add_error("Funções de popup win/lose não encontradas")

	# Drena eventos até STAGE_WON para exercitar o fluxo de vitória
	var won := false
	for i in 6000:
		var events: Array = game.sim.tick()
		for ev in events:
			if String(ev["type"]) == SimEvents.STAGE_WON:
				won = true
		if won:
			break
	if won:
		print("  ✓ Evento STAGE_WON emitido pela simulação")
	else:
		print("  ⚠ STAGE_WON não atingido em 6000 ticks (cena pode estar sem torres suficientes)")

func _find_stage_button(level_select: Node, stage_id: String) -> Button:
	var buttons = level_select.find_children("*", "Button", true, false)
	for btn in buttons:
		if btn.text.contains(stage_id) or String(btn.name).contains(stage_id):
			return btn
		for child in btn.get_children():
			if child is Label and child.text.contains(stage_id):
				return btn
	return null

func _add_error(msg: String) -> void:
	_test_passed = false
	_errors.append("[" + _current_step + "] " + msg)
	print("  ✗ ERRO: " + msg)

func _report() -> void:
	print("\n=== RELATÓRIO AutoPlayTest ===")
	if _test_passed:
		print("✓ TODOS OS TESTES PASSARAM")
	else:
		print("✗ FALHAS ENCONTRADAS:")
		for err in _errors:
			print("  - " + err)
		print("Total de erros: " + str(_errors.size()))
